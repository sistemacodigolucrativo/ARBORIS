# API and MySQL: server-only. Never prefix these secrets with VITE_.
DATABASE_URL=mysql://arboris:replace_with_a_strong_password@127.0.0.1:3306/arboris
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
APP_ORIGINS=http://localhost:3000,http://localhost:3001
# MYSQL_SSL=true
# TRUST_PROXY_HOPS=1  # Only when exactly one trusted reverse proxy fronts the API.
# COOKIE_CROSS_SITE=true  # Only for Pages + separate API over HTTPS.
# PUBLIC_API_ORIGIN=https://api.example.com

# Public frontend endpoint. Default /api supports the Vite proxy or same-origin hosting.
VITE_API_BASE_URL=/api

# Used ONLY by npm run db:password; remove after provisioning.
# ACCOUNT_USERNAME=admin
# ACCOUNT_PASSWORD=choose_at_least_12_characters

# Docker Compose only. URL-encode reserved characters in the URL password.
# MYSQL_PASSWORD=replace_with_strong_unique_password
# MYSQL_ROOT_PASSWORD=replace_with_another_strong_password
# DOCKER_DATABASE_URL=mysql://arboris:encoded_password@db:3306/arboris
