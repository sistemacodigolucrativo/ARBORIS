# ====================================================================
# ARBORIS ENVIRONMENT CONFIGURATION
# Production Ready for 512 MB RAM Linux VPS
# ====================================================================

APP_NAME="Arboris"
APP_ENV="production" # production | development
APP_DEBUG=false
APP_URL="http://seu-dominio.com.br"

# Database Connection
# Supported: sqlite | pgsql | mysql
DB_CONNECTION="sqlite"
DB_DATABASE="/var/www/arboris/database/arboris.sqlite"

# Credentials for PostgreSQL (when migrating)
# DB_CONNECTION="pgsql"
# DB_HOST="127.0.0.1"
# DB_PORT=5432
# DB_DATABASE="arboris"
# DB_USERNAME="arboris_user"
# DB_PASSWORD="secret_password"

# Session Security
SESSION_LIFETIME=86400
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE="Lax"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_TRANSFER_MAX=10
RATE_LIMIT_TRANSFER_WINDOW=60
