{
  "name": "arboris-reflorestamento",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:game": "node --import tsx scripts/test-game-engine.ts",
    "api:dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "api:start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/manage.ts migrate",
    "db:import": "node --env-file-if-exists=.env --import tsx server/manage.ts import",
    "db:password": "node --env-file-if-exists=.env --import tsx server/manage.ts password",
    "test:api": "node --import tsx --test server/*.test.ts",
    "test:ui": "node --import tsx server/ui-smoke.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.19.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "@vitejs/plugin-react": "^4.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
